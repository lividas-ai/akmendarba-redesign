{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premium business template lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lockedPaths", "replaceableRoots", "clientGeneratedPaths", "notes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "lockedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "replaceableRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "clientGeneratedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
