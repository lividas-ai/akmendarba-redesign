{
  "name": "premium-business-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:client && next build",
    "build:release": "pnpm validate:client:release && next build",
    "build:static": "pnpm validate:client && STATIC_EXPORT=true next build",
    "build:static:release": "pnpm validate:client:release && STATIC_EXPORT=true next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:client": "node --import ./scripts/register-ts-path-loader.mjs ./scripts/validate-site-manifest.mjs --mode draft",
    "validate:client:release": "node --import ./scripts/register-ts-path-loader.mjs ./scripts/validate-site-manifest.mjs --mode release",
    "check:lock": "node ./scripts/check-template-lock.mjs --snapshot ./template.lock.snapshot.json",
    "snapshot:lock": "node ./scripts/check-template-lock.mjs --write-snapshot ./template.lock.snapshot.json",
    "test:lock": "node --test ./tests/check-template-lock.test.mjs",
    "test:manifest": "node --import ./scripts/register-ts-path-loader.mjs --test ./scripts/site-manifest-acceptance.test.mjs",
    "check": "pnpm check:lock && pnpm typecheck && pnpm lint && pnpm test:lock && pnpm test:manifest && pnpm build && pnpm build:static"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "typescript": "^6.0.3"
  }
}
